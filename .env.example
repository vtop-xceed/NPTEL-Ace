# Google Analytics 4 Measurement ID (optional; the inline gtag in index.html already works)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Feedback form target (optional): baked default is the deployed Worker URL ending in /fb.
# Override here only if you redeploy the Worker under a different name/subdomain.
# 1. npx wrangler d1 create nptel-feedback   -> copy database_id into worker/wrangler.toml
# 2. cd worker && npx wrangler deploy        -> prints the workers.dev URL
VITE_FEEDBACK_ENDPOINT=https://nptel-feedback.sykik.workers.dev/fb
