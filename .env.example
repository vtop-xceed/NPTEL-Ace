# Google Analytics 4 Measurement ID (optional; the inline gtag in index.html already works)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Feedback form target: your deployed Cloudflare Worker URL, ending in /fb
# 1. npx wrangler d1 create nptel-feedback   -> copy database_id into worker/wrangler.toml
# 2. cd worker && npx wrangler deploy        -> prints the workers.dev URL
# 3. set this to <that-url>/fb and rebuild
VITE_FEEDBACK_ENDPOINT=https://nptel-feedback.<your-subdomain>.workers.dev/fb
